{
  "name": "torph-reactnative",
  "version": "0.1.2",
  "description": "Morphing UI for React Native: text, numbers, emoji, icons, trays and charts. Text engine ported from torph; built on Reanimated.",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./icons": {
      "types": "./lib/icons/index.d.ts",
      "react-native": "./src/icons/index.ts",
      "default": "./lib/icons/index.js"
    },
    "./chart": {
      "types": "./lib/chart/index.d.ts",
      "react-native": "./src/chart/index.ts",
      "default": "./lib/chart/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm test && pnpm typecheck && pnpm build"
  },
  "keywords": [
    "react-native",
    "reanimated",
    "text",
    "morph",
    "animation",
    "torph",
    "icons",
    "svg",
    "morph-icons",
    "tray",
    "chart"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.74",
    "react-native-reanimated": ">=3.6",
    "react-native-svg": ">=15"
  },
  "devDependencies": {
    "@torph/test-cases": "workspace:*",
    "@types/react": "~19.3.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "react-native-svg": "15.16.0"
  },
  "peerDependenciesMeta": {
    "react-native-svg": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bikash1376/torph-native.git",
    "directory": "packages/torph-native"
  },
  "homepage": "https://github.com/bikash1376/torph-native#readme",
  "bugs": {
    "url": "https://github.com/bikash1376/torph-native/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
